# Production frontend: build with Vite, serve with nginx (which also proxies /api to Rails).
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# Source download ("Tải mã nguồn"), packaged from the exact code being deployed.
FROM python:3.12-alpine AS source-zip
WORKDIR /src
COPY . .
RUN python scripts/package_code.py --output /out/edumate-source-code.zip

FROM nginx:1.27-alpine
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=source-zip /out/edumate-source-code.zip /usr/share/nginx/html/edumate-source-code.zip
