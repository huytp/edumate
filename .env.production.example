# Copy to .env.production and replace every value:
#   openssl rand -hex 24   -> passwords
#   openssl rand -hex 64   -> SECRET_KEY_BASE
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
SECRET_KEY_BASE=change-me
# Host port for the app (http://<server>:WEB_PORT)
WEB_PORT=8080
# Set to true once the app is served over HTTPS (e.g. behind Caddy with a domain).
FORCE_SSL=false
